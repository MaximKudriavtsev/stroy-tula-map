# Переменные для docker compose из корня монорепозитория.
# Для локального запуска без docker используйте services/backend/.env
# и services/frontend/.env.local.

# PostgreSQL / backend
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# frontend (вшивается в бандл на этапе next build)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
