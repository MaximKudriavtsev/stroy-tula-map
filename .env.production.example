NODE_ENV=production
API_MODE=live
DATA_MODE=real
ALLOW_DEV_ROUTES=false
ALLOW_SEED_DEMO=false
MESSENGER_ADAPTER=max

API_PORT=3000
PUBLIC_WEB_ORIGIN=https://example.invalid
ADMIN_WEB_ORIGIN=https://admin.example.invalid

DATABASE_URL=postgres://user:change-me@postgres:5432/tula
REDIS_URL=redis://redis:6379

S3_ENDPOINT=https://s3.example.invalid
S3_REGION=ru-central-1
S3_BUCKET=tula
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=false
