{
  "name": "menstroy-tula-map",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:unit": "tsx tools/run-feature-tests.ts --suite=unit",
    "test:integration": "tsx tools/run-feature-tests.ts --suite=integration",
    "test:e2e": "tsx tools/run-feature-tests.ts --suite=e2e",
    "contracts:gen": "tsx tools/generate-contracts.ts",
    "contracts:check": "tsx tools/generate-contracts.ts --check && vitest run tests/contracts --reporter=dot",
    "build": "pnpm contracts:gen && pnpm -r --if-present build",
    "dev": "concurrently -n api,public,admin -c blue,green,magenta \"pnpm --filter @tula/api dev\" \"pnpm --filter @tula/public-web dev\" \"pnpm --filter @tula/admin-web dev\"",
    "db:migrate": "pnpm --filter @tula/db migrate",
    "seed:demo": "tsx tools/seed-demo.ts",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8",
    "@tula/api-client": "workspace:*",
    "@tula/contracts": "workspace:*",
    "@tula/db": "workspace:*",
    "@tula/fixtures": "workspace:*"
  }
}
